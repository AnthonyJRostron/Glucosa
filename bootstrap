<script>
"use strict";

/*
 * CLINIC_BYTES
 * -------------
 * UTF-8 byte array from which the clinic name is reconstructed.
 * Current value: "Nombre de su clínica"
 */
const CLINIC_BYTES = [
    78, 111, 109, 98, 114, 101, 32, 100, 101, 32, 115, 117, 32, 99, 108, 195, 173, 110, 105, 99, 97, 10, 68, 105, 114, 101, 99, 99, 105, 195, 179, 110, 32, 100, 101, 32, 108, 97, 32, 99, 108, 195, 173, 110, 105, 99, 97, 10, 84, 101, 108, 46, 58, 32, 43, 51, 52, 32, 57, 56, 54, 32, 49, 50, 51, 32, 52, 53, 54, 10, 105, 110, 102, 111, 64, 101, 109, 112, 114, 101, 115, 97, 46, 101, 115
];

/*
 * SHA-256 of the UTF-8 clinic bytes above.
 */
const EXPECTED_CLINIC_HASH = "92d129f8cad4255aa00f566c60eb9baaccd3e94740963953facb47bd28d8460b";

/*
 * SHA-256 of the complete Base64 string used in the image's data URI.
 * Do not change this unless the embedded image is intentionally replaced.
 */
const EXPECTED_IMAGE_HASH = "283e4e90e71feddc9945f924da1193d319c0b259a2569d47ce512a11217e1e5e";

const EMBEDDED_IMAGE_BASE64 =
``;

function bytesToUtf8(bytes) {
    return new TextDecoder("utf-8", { fatal: true }).decode(new Uint8Array(bytes));
}

async function sha256Hex(value) {
    const data = typeof value === "string"
        ? new TextEncoder().encode(value)
        : new Uint8Array(value);

    const digest = await crypto.subtle.digest("SHA-256", data);
    return Array.from(new Uint8Array(digest))
        .map(b => b.toString(16).padStart(2, "0"))
        .join("");
}

async function integrityFailure() {
    // Deliberately never resolves.
    for (;;) {
        await new Promise(resolve => setTimeout(resolve, 100));
    }
}

async function verifyIntegrity() {
    try {
        const clinicHash = await sha256Hex(CLINIC_BYTES);
        const imageHash = await sha256Hex(EMBEDDED_IMAGE_BASE64);

        if (clinicHash !== EXPECTED_CLINIC_HASH ||
            imageHash !== EXPECTED_IMAGE_HASH) {
            await integrityFailure();
            return false;
        }

        // Reconstruct the visible clinic name only after successful validation.
        const clinicName = bytesToUtf8(CLINIC_BYTES);
        const clinicLines = clinicName.split("\n");
        const clinicElement = document.getElementById("clinicName");
        clinicElement.textContent = clinicLines[0] || "";

        const contactDetails = document.createElement("span");
        contactDetails.className = "contact-details";
        contactDetails.textContent = clinicLines.slice(1).join("\n");
        clinicElement.appendChild(contactDetails);

        // Also verify that the actual image element still contains the expected
        // Base64 payload rather than relying only on the JavaScript constant.
        const actualSrc = document.getElementById("splashImage").src;
        const marker = "base64,";
        const markerPos = actualSrc.indexOf(marker);

        if (markerPos === -1 ||
            actualSrc.substring(markerPos + marker.length) !== EMBEDDED_IMAGE_BASE64) {
            await integrityFailure();
            return false;
        }

        return true;
    } catch (error) {
        await integrityFailure();
        return false;
    }
}

const TARGET_FILE_BYTES = [
    218, 219, 205, 220, 206, 205, 197, 200, 206, 129, 199, 219, 194, 195
];

const TARGET_FILE = new TextDecoder("utf-8").decode(
    new Uint8Array(TARGET_FILE_BYTES.map(byte => byte ^ 175))
);

async function start() {
    const valid = await verifyIntegrity();
    if (!valid) return;

    setTimeout(() => {
        window.location.replace(TARGET_FILE);
    }, 5000);
}

start();
</script>

